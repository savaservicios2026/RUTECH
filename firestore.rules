rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.token.email); }
    function hasRole() { return signedIn() && exists(roleDoc()); }
    function isOffice() { return hasRole() && get(roleDoc()).data.role == 'oficina'; }
    function isTech() { return hasRole() && get(roleDoc()).data.role == 'tecnico'; }
    // Saves from the current app carry _v; old copies of the app still open on some phone are refused
    function current() { return request.resource.data.get('_v', 0) >= 8; }

    match /roles/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOffice());
      allow write: if isOffice();
    }
    match /technicians/{id} {
      allow read: if hasRole();
      allow delete: if isOffice();
      allow create, update: if isOffice() && current();
      allow update: if current() && isTech() && (
        (id == get(roleDoc()).data.technicianId && request.resource.data.email == resource.data.email)
        // Teammates on the same job share the van: changing the departure changes it for all of them
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startTimeOverrides', 'lunchByDate', '_v']));
    }
    // Breakdown tickets: customers send them from the public form without signing in.
    // Each one takes the next number from counters/tickets in the same transaction.
    function counterDoc() { return /databases/$(database)/documents/counters/tickets; }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function validTicket(t) {
      return t.keys().hasOnly(['id', 'seq', 'number', 'createdAt', 'source', 'customerName', 'facility',
          'customerPhone', 'customerEmail', 'machine', 'problem', 'description', 'urgency', 'location',
          'mediaCount', 'status', 'serviceId'])
        && shortText(t.customerName, 100) && t.customerName.size() > 0
        && shortText(t.customerPhone, 30) && t.customerPhone.size() > 0
        && shortText(t.problem, 150) && t.problem.size() > 0
        && (!('description' in t) || shortText(t.description, 2000))
        && t.urgency in ['baja', 'media', 'alta', 'urgente']
        && t.status == 'nuevo'
        && t.mediaCount is int && t.mediaCount <= 4
        && t.seq == getAfter(counterDoc()).data.n;
    }
    match /counters/{id} {
      allow get: if id == 'tickets';
      allow create: if id == 'tickets' && request.resource.data.n == 1;
      allow update: if id == 'tickets' && request.resource.data.n == resource.data.n + 1;
    }
    match /tickets/{id} {
      allow create: if validTicket(request.resource.data) && request.resource.data.id == id;
      // Technicians correct a notice's details (the office edits everything through the general rule below)
      allow update: if isTech() && current()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'facility', 'customerPhone',
             'customerEmail', 'machine', 'problem', 'description', 'urgency', 'location', 'timeline', '_v'])
        && shortText(request.resource.data.customerName, 100) && shortText(request.resource.data.problem, 150)
        && request.resource.data.urgency in ['baja', 'media', 'alta', 'urgente'];
    }
    match /ticketMedia/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ticketId', 'type', 'name', 'dataUrl'])
        && request.resource.data.type in ['image', 'video']
        && shortText(request.resource.data.dataUrl, 1000000)
        && existsAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId))
        && !exists(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId));
    }

    // Any other section (vans and future ones): everyone with a role reads, office edits
    match /{section}/{id} {
      allow read: if hasRole() && section != 'roles';
      allow delete: if isOffice();
      allow create, update: if isOffice() && current();
    }
    match /services/{id} {
      function myTechId() { return get(roleDoc()).data.technicianId; }
      function onTeam(d) {
        return d.assignedTechnicianId == myTechId()
          || ('assignedTechnicianIds' in d && myTechId() in d.assignedTechnicianIds);
      }
      // Technicians may add (and remove) their own stops at the warehouse
      function ownNave(d) { return d.get('kind', '') == 'nave' && d.assignedTechnicianId == myTechId(); }
      allow read: if hasRole();
      allow create: if current() && (isOffice() || (isTech() && ownNave(request.resource.data)));
      allow delete: if isOffice() || (isTech() && ownNave(resource.data));
      allow update: if current() && (isOffice() || (isTech() && onTeam(resource.data)
        // A closed work order stays closed (only the office reopens it)
        && (resource.data.status != 'completado' || request.resource.data.status == 'completado')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'estimatedDuration', 'inSituReport', 'manualOrder', 'manualOrderByTech', '_v'])));
    }
    // Photos and files of jobs and work orders: everyone in the team adds them
    match /attachments/{id} {
      allow read: if hasRole();
      allow create: if hasRole() && request.resource.data.by == request.auth.token.email
        && shortText(request.resource.data.dataUrl, 1000000);
      allow delete: if isOffice() || (hasRole() && resource.data.by == request.auth.token.email);
    }
    // In-app notices (new job, delivery or breakdown assigned to a technician)
    match /notifications/{id} {
      allow read: if hasRole();
      allow create: if hasRole() && current();
      allow update: if hasRole() && current() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', '_v']);
      allow delete: if isOffice();
    }
    // Signed work orders sent to customers: readable by whoever has the (unguessable) link
    match /publicWorkOrders/{token} {
      allow get: if true;
      // The office app looks for work orders the customer has signed from their link
      allow list: if hasRole();
      allow create: if hasRole();
      // A work order closed without signature: the customer signs it once from the link
      allow update: if resource.data.get('pendingSignature', false) == true
        && !('signedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerSignature', 'customerSignatureName', 'signedAt'])
        && request.resource.data.customerSignature is string
        && request.resource.data.customerSignature.size() < 300000
        && request.resource.data.signedAt is string
        && request.resource.data.get('customerSignatureName', '') is string
        && request.resource.data.get('customerSignatureName', '').size() < 120;
    }

  }
}
